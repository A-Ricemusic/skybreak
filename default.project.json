{
  "name": "Last Tide",
  "tree": {
    "$className": "DataModel",
    "ReplicatedStorage": {
      "Shared": {
        "$path": "out/shared"
      },
      "rbxts_include": {
        "$path": "include",
        "node_modules": {
          "$className": "Folder",
          "@rbxts": {
            "$path": "node_modules/@rbxts"
          },
          "@rbxts-js": {
            "$path": "node_modules/@rbxts-js"
          }
        }
      }
    },
    "ServerScriptService": {
      "Server": {
        "$path": "out/server"
      }
    },
    "StarterPlayer": {
      "StarterPlayerScripts": {
        "Client": {
          "$path": "out/client"
        }
      }
    },
    "Workspace": {
      "$properties": {
        "FilteringEnabled": true,
        "FallenPartsDestroyHeight": -500
      }
    },
    "ServerStorage": {
      "KestrelGeometry": {
        "$path": "build/KestrelGeometry.txt"
      },
      "VantaGeometry": {
        "$path": "build/VantaGeometry.txt"
      },
      "WarehouseGeometry": {
        "$path": "build/WarehouseGeometry.txt"
      },
      "RadarGeometry": {
        "$path": "build/RadarGeometry.txt"
      },
      "CorvetteGeometry": {
        "$path": "build/CorvetteGeometry.txt"
      },
      "SamGeometry": {
        "$path": "build/SamGeometry.txt"
      }
    }
  }
}
