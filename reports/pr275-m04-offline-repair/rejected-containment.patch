+export function containedTerrainJobs(jobs: TerrainJob[]): TerrainJob[] {
+ const out: TerrainJob[] = [];
+ for (let start = 0; start < jobs.size(); start += 128) {
+  const window: TerrainJob[] = [];
+  for (let index=start; index<math.min(jobs.size(),start+128); index++) window.push(jobs[index]);
+  const buckets = new Map<string, number[]>();
+  const regions: GridRegion[] = [];
+  const keys: string[][] = [];
+  let fallback = false;
+  for (const job of window) {
+   const r = alignedBlockRegion(job.op);
+   if (job.region !== undefined || job.op.material === "Water" || r === undefined || job.op.material !== window[0].op.material) { fallback = true; break; }
+   const lo = r.min.map((v) => math.floor(v / 256));
+   const hi = r.max.map((v) => math.ceil(v / 256) - 1);
+   if ((hi[0]-lo[0]+1)*(hi[1]-lo[1]+1)*(hi[2]-lo[2]+1)>64) { fallback = true; break; }
