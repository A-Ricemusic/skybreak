{
  "name": "SKYBREAK Jest Tests",
  "tree": {
    "$className": "DataModel",
    "ReplicatedStorage": {
      "Shared": {
        "$path": "out/shared"
      },
      "rbxts_include": {
        "$path": "include",
        "node_modules": {
          "$className": "Folder",
          "@rbxts": {
            "$path": "node_modules/@rbxts"
          },
          "@rbxts-js": {
            "$path": "node_modules/@rbxts-js"
          }
        }
      }
    },
    "ServerScriptService": {
      "Server": {
        "$path": "out/server"
      }
    },
    "StarterPlayer": {
      "StarterPlayerScripts": {
        "Client": {
          "$path": "out/client"
        }
      }
    },
    "Workspace": {
      "$properties": {
        "FilteringEnabled": true,
        "FallenPartsDestroyHeight": -500,
        "StreamingEnabled": false
      },
      "$attributes": {
        "SkybreakTestMode": true
      }
    },
    "Players": {
      "$properties": {
        "CharacterAutoLoads": false
      }
    },
    "ServerStorage": {
      "Tests": {
        "$path": "out/tests"
      },
      "KestrelGeometry": {
        "$path": "build/KestrelGeometry.txt"
      },
      "VantaGeometry": {
        "$path": "build/VantaGeometry.txt"
      },
      "WarehouseGeometry": {
        "$path": "build/WarehouseGeometry.txt"
      },
      "RadarGeometry": {
        "$path": "build/RadarGeometry.txt"
      },
      "CommsRelayGeometry": {
        "$path": "build/CommsRelayGeometry.txt"
      },
      "GrainSiloGeometry": {
        "$path": "build/GrainSiloGeometry.txt"
      },
      "RelayTruckGeometry": {
        "$path": "build/RelayTruckGeometry.txt"
      },
      "HarborLaunchGeometry": {
        "$path": "build/HarborLaunchGeometry.txt"
      },
      "CinematicChairGeometry": {
        "$path": "build/CinematicChairGeometry.txt"
      },
      "CinematicDeskGeometry": {
        "$path": "build/CinematicDeskGeometry.txt"
      },
      "RunwayTileGeometry": {
        "$path": "build/RunwayTileGeometry.txt"
      },
      "RoadTileGeometry": {
        "$path": "build/RoadTileGeometry.txt"
      },
      "CliffTileGeometry": {
        "$path": "build/CliffTileGeometry.txt"
      }
    }
  }
}
