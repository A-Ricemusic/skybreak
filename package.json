{
  "name": "skybreak-operation-glass-horizon",
  "version": "0.1.0",
  "private": true,
  "packageManager": "bun@1.3.14",
  "scripts": {
    "clean": "bun tools/clean-artifacts.ts",
    "clean:check": "bun tools/clean-artifacts.ts --dry-run",
    "build": "bun tools/package-aircraft.ts && rbxtsc --rojo test.project.json",
    "watch": "bun tools/package-aircraft.ts && rbxtsc --rojo test.project.json -w",
    "build:place": "bun run build && mkdir -p build && rojo build -o build/skybreak.rbxlx",
    "serve": "rojo serve",
    "test": "bun run test:roblox",
    "test:offline": "bun tools/test-offline.ts",
    "test:roblox": "bun tools/test-roblox.ts"
  },
  "devDependencies": {
    "@rbxts/compiler-types": "3.0.0-types.0",
    "@rbxts/types": "^1.0.959",
    "roblox-ts": "3.0.0",
    "typescript": "5.5.3"
  },
  "dependencies": {
    "@rbxts/jest": "3.16.0-ts.2",
    "@rbxts/jest-globals": "3.16.0-ts.2",
    "@rbxts/react": "17.3.13-ts.1",
    "@rbxts/react-roblox": "17.3.13-ts.1",
    "@rbxts/services": "^1.6.0"
  },
  "patchedDependencies": {
    "roblox-ts@3.0.0": "patches/roblox-ts@3.0.0.patch"
  }
}
