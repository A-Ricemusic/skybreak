{
  "name": "skybreak-operation-glass-horizon",
  "version": "0.1.0",
  "private": true,
  "packageManager": "bun@1.3.14",
  "scripts": {
    "validate:offline": "bun tools/validate-offline.ts",
    "clean": "bun tools/clean-artifacts.ts",
    "clean:check": "bun tools/clean-artifacts.ts --dry-run",
    "build": "bun tools/package-aircraft.ts && rbxtsc --rojo test.project.json",
    "watch": "bun tools/package-aircraft.ts && rbxtsc --rojo test.project.json -w",
    "build:place": "bun run build && mkdir -p build && rojo build -o build/skybreak.rbxlx && python3 tools/check-place-voice.py build/skybreak.rbxlx",
    "serve": "rojo serve",
    "test": "bun run test:roblox",
    "test:roblox": "bun tools/test-roblox.ts",
    "test:audio:offline": "bun run build && bun tools/test-audio-offline.ts",
    "test:offline": "bun run build && bun tools/test-relay-offline.ts",
    "test:radio:offline": "bun run build && bun tools/test-radio-delivery.ts",
    "docs:relay-tables": "bun tools/relay-tables.ts",
    "docs:world-counts": "bun tools/world-report.ts",
    "test:voice:offline": "bun run build && bun tools/test-voice-offline.ts && python3 -m unittest discover -s tools/tests -p test_place_voice.py",
    "test:roblox:perf": "bun tools/test-roblox.ts --perf"
  },
  "devDependencies": {
    "@rbxts/compiler-types": "3.0.0-types.0",
    "@rbxts/types": "^1.0.959",
    "roblox-ts": "3.0.0",
    "typescript": "5.5.3"
  },
  "dependencies": {
    "@rbxts/jest": "3.16.0-ts.2",
    "@rbxts/jest-globals": "3.16.0-ts.2",
    "@rbxts/react": "17.3.13-ts.1",
    "@rbxts/react-roblox": "17.3.13-ts.1",
    "@rbxts/services": "^1.6.0"
  },
  "patchedDependencies": {
    "roblox-ts@3.0.0": "patches/roblox-ts@3.0.0.patch"
  }
}
