{
  "name": "react-agent-testing",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "packageManager": "bun@1.3.14",
  "scripts": {
    "dev": "bun --bun vite --host 127.0.0.1",
    "build": "tsc --noEmit && bun --bun vite build",
    "test:agent": "bun tools/run-agent.ts",
    "test:agent:broken": "bun tools/run-agent.ts --broken"
  },
  "dependencies": {
    "react": "^19.3.1",
    "react-dom": "^19.3.1"
  },
  "devDependencies": {
    "@modelcontextprotocol/sdk": "^1.0.0",
    "zod": "^3.25.0",
    "playwright": "^1.64.1",
    "vite": "^8.3.5",
    "@vitejs/plugin-react": "^6.1.2",
    "typescript": "^7.0.2",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/bun": "latest"
  }
}
