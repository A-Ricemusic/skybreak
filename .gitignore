# Procedurally generated aircraft exports. The Python generators and the
# runtime-required mesh JSON files remain tracked.
assets/aircraft/*.blend
assets/aircraft/*.blend[0-9]*
assets/aircraft/*.fbx
assets/aircraft/*.glb
assets/aircraft/*.stats.json
assets/aircraft/*-three-quarter.png
assets/aircraft/*-top.png

# Operating-system metadata
.DS_Store
